# Build output
build/
web/dist/
web/node_modules/
node_modules/

# Emscripten output. Generated by `cmake --build --preset wasm-release` and by
# CI on every deploy, so committing it would only create merge conflicts and
# let a stale binary ship silently.
web/public/wasm/parallax.js
web/public/wasm/parallax.wasm
web/public/wasm/parallax.wasm.map

# Snapshots are the exception to the "no generated artifacts" rule: the
# compiled .pxsnap binaries ARE committed, on purpose. They are what lets the
# site work with no backend, and CI refreshes them on a schedule.
# data/snapshots/*.pxsnap is intentionally NOT ignored.
data/snapshots/*.ndjson
data/snapshots/*.raw.json

# Tooling
compile_commands.json
.cache/
.DS_Store
*.tsbuildinfo

# Secrets. There are none in this project by design — every data source is
# keyless — but an ignore rule costs nothing and the absence of one is how
# accidents happen.
.env
.env.*
!.env.example
